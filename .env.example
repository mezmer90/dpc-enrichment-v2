# DPC Enrichment V2 - Environment Variables Template
# Copy this file to .env and fill in your actual API keys
# NEVER commit the .env file to version control

# ==================== REQUIRED API KEYS ====================

# OpenRouter API Key (for Gemini 2.5 Flash AI model)
# Get your key from: https://openrouter.ai/keys
# Used for: Smart URL selection + Data extraction
# Cost: ~$0.006 per practice
OPENROUTER_API_KEY=sk-or-v1-YOUR_OPENROUTER_API_KEY_HERE

# ScraperAPI Key (for web scraping with 98.9% success rate)
# Get your key from: https://www.scraperapi.com/
# Used for: Website scraping with JS rendering, Cloudflare bypass
# Cost: ~$0.024 per practice (avg 7 pages × $0.003/page)
SCRAPERAPI_KEY=YOUR_SCRAPERAPI_KEY_HERE

# ==================== OPTIONAL API KEYS ====================

# Serper API Key (optional - for search functionality)
# Get your key from: https://serper.dev/
# Currently not used in main enrichment pipeline
SERPER_API_KEY=YOUR_SERPER_KEY_HERE

# ==================== WEB APP CONFIGURATION ====================

# Web App Password (for simple authentication)
# Change this to a secure password in production!
APP_PASSWORD=dpc2025

# Flask Secret Key (for session management)
# Generate a random key: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=your-random-secret-key-here

# Database URL (auto-provided by Railway, or use local PostgreSQL)
# DATABASE_URL=postgresql://user:password@localhost/dpcenrich

# Redis URL (auto-provided by Railway, or use local Redis)
# REDIS_URL=redis://localhost:6379/0

# ==================== ENRICHMENT CONFIGURATION ====================

# Enable/disable ScraperAPI (true/false)
# Set to false to use fallback scrapers (Playwright, Selenium, etc.)
USE_SCRAPING_API=true

# Max concurrent workers for enrichment (reduced from 6 to prevent resource exhaustion)
MAX_WORKERS=2

# Save checkpoint every N practices
CHECKPOINT_INTERVAL=1

# ==================== RESOURCE LIMITS ====================

# Thread limits for numpy/pandas operations (prevents thread explosion)
# CRITICAL: These prevent OpenBLAS from spawning 48 threads per worker
OPENBLAS_NUM_THREADS=4
OMP_NUM_THREADS=4
MKL_NUM_THREADS=4

# Playwright browser cache (for Railway deployment)
PLAYWRIGHT_BROWSERS_PATH=/tmp/.playwright

# ==================== SETUP INSTRUCTIONS ====================
#
# 1. Copy this file to .env in the same directory:
#    copy .env.example .env
#
# 2. Edit .env and replace the placeholder values with your actual API keys
#
# 3. Add .env to .gitignore to prevent committing secrets:
#    echo .env >> .gitignore
#
# 4. Run the setup check:
#    python -c "from dotenv import load_dotenv; load_dotenv(); import os; print('OPENROUTER_API_KEY:', 'Set' if os.getenv('OPENROUTER_API_KEY') else 'Missing')"
#
# ==================== COST ESTIMATES ====================
#
# Test run (5 practices):
#   - ScraperAPI: ~$0.12
#   - Gemini AI: ~$0.03
#   - Total: ~$0.15
#   - Time: ~30 seconds
#
# Full run (2,763 practices):
#   - ScraperAPI: ~$66
#   - Gemini AI: ~$17
#   - Total: ~$83
#   - Time: 3-5 hours
#
# Success rate: 90-95%
# Output: 80+ fields per practice
